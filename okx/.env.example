# Copy to okx/.env and chmod 600. It is gitignored.
#
# The model that writes the report. A slash in OKX_AGENT_MODEL means an OpenRouter slug
# (vendor/model); without a slash, run.py falls back to ANTHROPIC_API_KEY or OPENAI_API_KEY.
# Production setting, chosen 2026-09-20 by comparing verify.py violation counts:
OKX_AGENT_MODEL=deepseek/deepseek-v4-flash
OKX_AGENT_EFFORT=high
OPENROUTER_API_KEY=
# OKX_AGENT_UPSTREAM=Alibaba   # pinned: the only upstream that supports `seed`
#
# Alternatives, used when the model name has no slash:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
