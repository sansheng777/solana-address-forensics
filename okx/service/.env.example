# Copy to .env and chmod 600. ★ Never commit this file.
# ── x402 seller side (apply at the OKX Developer Portal) ──
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
# ── Payee wallet (an EVM address on X Layer; an Agentic Wallet address works) ──
PAY_TO_ADDRESS=
# ── Network. ★ Mainnet only: the payment SDK has no default stablecoin registered for the testnet,
#    so a fiat price cannot be converted and the route answers 500 instead of 402 (see README).
X402_NETWORK=eip155:196
# ── Price per call. A USD string; the SDK converts it to the network stablecoin's atomic units ──
X402_PRICE=$0.10
# ── Downstream: Dune (data) and the model (writing the report) ──
DUNE_API_KEY=
OPENROUTER_API_KEY=
OKX_AGENT_MODEL=deepseek/deepseek-v4-flash
OKX_AGENT_EFFORT=high

# ── The public https address. ★ Without it the 402 challenge advertises resource.url as http://
#    (the protocol the container sees), which breaks the buyer's replay and marketplace validation.
PUBLIC_URL=https://your.domain

# ── Production knobs (all optional; defaults in brackets) ──
# OKX_MAX_WORKERS=2        # reports computed at once; the rest queue
# OKX_MAX_ATTEMPTS=2       # free retries of a failed paid job
# OKX_RETRY_DELAY=15       # seconds before that retry
# OKX_RL_PER_MIN=60        # per-IP limit on the free routes (POST /profile is exempt)
# OKX_TOKEN_TTL_DAYS=30    # how long a pickup token stays valid
# DUNE_WAIT_DEADLINE=900   # seconds before a stuck Dune execution is abandoned
