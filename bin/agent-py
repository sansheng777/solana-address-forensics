#!/usr/bin/env bash
# Run a layer-4 script inside a container (injecting the model credentials from okx/.env).
# Usage: ./bin/agent-py /work/okx/agent/run.py /work/okx/data/_f4_d1_4vw54B.json --tag round1
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
args=(); for a in "$@"; do args+=("${a/#$ROOT//work}"); done
envflag=(); [ -f "$ROOT/okx/.env" ] && envflag=(--env-file "$ROOT/okx/.env")
tty_flags=(-i); [ -t 0 ] && [ -t 1 ] && tty_flags=(-it)
exec docker run --rm "${tty_flags[@]}" "${envflag[@]}" \
  -v "$ROOT":/work -w /work python:3.12-slim python3 "${args[@]}"
